# Backend Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Default: SQLite for zero-config local run)
# For PostgreSQL (e.g. Render / Railway / Supabase), switch provider in schema.prisma and use:
# DATABASE_URL="postgresql://user:password@localhost:5432/quizapp?schema=public"
DATABASE_URL="file:./dev.db"

# Frontend Configuration (used in /client)
VITE_SERVER_URL=http://localhost:4000
