{
  "name": "classroom-quiz-server",
  "version": "1.0.0",
  "description": "Backend server for real-time multiplayer classroom quiz",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "seed": "node prisma/seed.js",
    "simulate": "node scripts/simulateStudents.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.3",
    "nodemailer": "^10.0.8",
    "prisma": "^6.4.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  }
}
